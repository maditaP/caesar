// RUN: @caesar synth --timeout 300 --refinement-mode fixed @file

domain Invariants {
    syn func hello(tfail:UInt [0,10], tsent: UInt [0,8000000000]) : EUReal
}

coproc brp () -> (fail: UInt [0,10])
pre 0.00001
post [fail == 10]
{
    var sent: UInt [0,8000000000] = 0
    fail = 0

    @invariant(hello(fail, sent))
    while (fail < 10 && sent < 8000000000) {
        var prob_choice: Bool = flip(0.99)
        if prob_choice {
            fail = 0
            sent = sent +1
        } else {
            fail = fail + 1
        }
    }
}
