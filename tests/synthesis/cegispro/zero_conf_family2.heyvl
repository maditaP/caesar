// RUN: @caesar synth --timeout 120 --refinement-mode fixed @file

domain Invariants {
    syn func hello(
        tstart: UInt [0,1],
        testablished: UInt [0,1],
        tcurprobe: UInt [0,200000000],
        tN: UInt [100000000,200000000]
    ) : EUReal

}

coproc zero_conf_family (N : UInt [100000000,200000000]) -> (established : UInt [0,1])
pre 0.555
post [established == 1]
{
    var start: UInt  [0,1] = 1
    var curprobe: UInt [0,200000000] = 0

    established = 0

    @invariant(
        hello(start, established, curprobe, N)
    )
    while (
        curprobe < N &&
        established <= 0
        &&
        start <= 1 &&
        N >= 100000000 &&
        N <= 200000000
    ) {

        if (start == 1) {

            var prob_choice: Bool = flip(0.5)
            if prob_choice {
                start = 0
            } else {
                start = 0
                established = 1
            }

        } else {

            var prob_choice: Bool = flip(0.999999999)
            if prob_choice {
                curprobe = curprobe + 1
            } else {
                start = 1
                curprobe = 0
            }
        }
    }
}
