// RUN: @caesar synth --timeout 300 --refinement-mode degree --unsigned-coefficients @file
// XFAIL: timeout

domain Invariants {
    syn func inv(n: UInt, x: UInt, p: UReal) : UReal
}

proc loop_proc(init_n: UInt, init_x: UInt, p: UReal) -> (x: UInt)
pre init_x + [init_n > 0]*((p*init_n)/2)
post x
{
    var n: UInt = init_n
    x = init_x

    @invariant(inv(n, x, p))
    while (n > 0) {
        var prob_choice: Bool = flip(p)
        if prob_choice {
            x = x + n
        } else {
        }
        n = n - 1
    }
}
