// RUN: @caesar synth --timeout 300 --refinement-mode degree @file
// XFAIL: timeout

domain MoreInvariants {
    syn func c4b_t19_first_inv(i: Int, k: Int) : EUReal
    syn func c4b_t19_second_inv(i: Int) : EUReal
}

@ert
coproc main(init_i: Int, init_k: Int) -> (i: Int, k: Int)
    pre c4b_t19_first_inv(init_i, init_k)
    post 0
{
    var prob_choice: Bool
    i = init_i
    k = init_k
    @invariant(c4b_t19_first_inv(i,k))
    while i > 100 {
        prob_choice = flip(1/2)
        if prob_choice {
            i = i - 1
        } else {
            i = i + 0
        }
        tick 1
    }
    i = i + k + 50
    @invariant(c4b_t19_second_inv(i))
    while i > 0 {
        i = i - 1
        tick 1
    }
}
