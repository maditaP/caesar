// RUN: @caesar synth --refinement-mode degree @file

domain MoreInvariants {
    syn func coupon_inv(i: Int) : EUReal
}

@ert
coproc main() -> (i: Int)
    pre coupon_inv(0)
    post 0
{
    var prob_choice: Bool
    i = 0
    @invariant(coupon_inv(i))
    while i < 5 {
        if i == 0 {
            i = i + 1
        } else {
            if i == 1 {
                prob_choice = flip(1/5)
                if prob_choice {
                    i = 1
                } else {
                    i = i + 1
                }
            } else {
                if i == 2 {
                    prob_choice = flip(2/5)
                    if prob_choice {
                        i = 2
                    } else {
                        i = i + 1
                    }
                } else {
                    if i == 3 {
                        prob_choice = flip(3/5)
                        if prob_choice {
                            i = 3
                        } else {
                            i = i + 1
                        }
                    } else {
                        prob_choice = flip(4/5)
                        if prob_choice {
                            i = 4
                        } else {
                            i = i + 1
                        }
                    }
                }
            }
        }
        tick 1
    }
}
