// RUN: @caesar synth --refinement-mode degree @file

domain MoreInvariants {
    syn func robot_inv(n: UInt) : EUReal
}

@ert
coproc main(init_n: UInt) -> (x: UInt, y: UInt, eX: UInt, eY: UInt, dx: UInt, dy: UInt, dxc: UInt, dyc: UInt, n: UInt, cmd: UInt)
    pre robot_inv(init_n)
    post 0
{
    var prob_choice: Bool
    x = 0
    y = 0
    eX = 0
    eY = 0
    dx = 0
    dy = 0
    dxc = 0
    dyc = 0
    n = init_n

    @invariant(robot_inv(n))
    while 0 < n {
        dx = 0
        dy = 0

        prob_choice = flip(1/10)
        if prob_choice {
            cmd = 0
        } else {
            prob_choice = flip(1/9)
            if prob_choice {
                cmd = 1
            } else {
                prob_choice = flip(1/8)
                if prob_choice {
                    cmd = 2
                } else {
                    prob_choice = flip(1/7)
                    if prob_choice {
                        cmd = 3
                    } else {
                        prob_choice = flip(1/6)
                        if prob_choice {
                            cmd = 4
                        } else {
                            prob_choice = flip(1/5)
                            if prob_choice {
                                cmd = 5
                            } else {
                                prob_choice = flip(1/4)
                                if prob_choice {
                                    cmd = 6
                                } else {
                                    prob_choice = flip(1/3)
                                    if prob_choice {
                                        cmd = 7
                                    } else {
                                        cmd = 8
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if cmd == 0 {
            n = n - 1
        } else {
            if cmd == 1 {
                n = n - 2
            } else {
                if cmd == 2 {
                    n = n - 3
                } else {
                    if cmd == 3 {
                        n = n - 4
                    } else {
                        if cmd == 4 {
                            n = n - 5
                        } else {
                            if cmd == 5 {
                                n = n - 6
                            } else {
                                if cmd == 6 {
                                    n = n - 7
                                } else {
                                    if cmd == 7 {
                                        n = n - 8
                                    } else {
                                        n = n + 0
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        tick 1
    }
}
