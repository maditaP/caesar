// RUN: @caesar synth --timeout 300 --refinement-mode degree @file
// XFAIL: timeout

domain MoreInvariants {
    syn func prspeed2_inv(x: Int, y: Int, m: Int, n: Int) : EUReal
}

@ert
coproc main(init_x: Int, init_y: Int, init_m: Int, init_n: Int) -> (x: Int, y: Int, m: Int, n: Int)
    pre prspeed2_inv(init_x, init_y, init_m, init_n)
    post 0
{
    var prob_choice: Bool
    x = init_x
    y = init_y
    m = init_m
    n = init_n
    @invariant(prspeed2_inv(x, y, m, n))
    while x <= n {
        if y < m {
            prob_choice = flip(1/2)
            if prob_choice {
                y = y + 1
            } else {
                y = y + 0
            }
        } else {
            prob_choice = flip(1/4)
            if prob_choice {
                x = x + 0
            } else {
                prob_choice = flip(1/3)
                if prob_choice {
                    x = x + 1
                } else {
                    prob_choice = flip(1/2)
                    if prob_choice {
                        x = x + 2
                    } else {
                        x = x + 3
                    }
                }
            }
        }
        tick 1
    }
}
