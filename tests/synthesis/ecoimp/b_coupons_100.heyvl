// RUN: @caesar synth --refinement-mode degree @file

domain MoreInvariants {
    syn func coupons100_inv(coupons: UInt) : EUReal
}

@ert
coproc main() -> (coupons: UInt, draw: UInt)
    pre coupons100_inv(0)
    post 0
{
    coupons = 0
    draw = 0
    @invariant(coupons100_inv(coupons))
    while coupons < 100 {
        tick 1
        draw = unif(0, 100)
        if draw > coupons {
            coupons = coupons + 1
        } else {
            coupons = coupons + 0
        }
    }
}
