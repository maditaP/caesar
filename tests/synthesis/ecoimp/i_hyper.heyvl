// RUN: @caesar synth --refinement-mode degree @file

domain MoreInvariants {
    syn func hyper_inv(x: Int, n: Int) : EUReal
}

@ert
coproc main(init_x: Int, init_n: Int) -> (x: Int, n: Int, r: UInt)
    pre hyper_inv(init_x, init_n)
    post 0
{
    x = init_x
    n = init_n
    @invariant(hyper_inv(x, n))
    while x + 2 <= n {
        r = hyper(30, 3, 2)
        x = x + r
        tick 1
    }
}
